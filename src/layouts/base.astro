---

export interface Props {
    title: string
}

const {
    title
} = Astro.props // how does this work?
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} - foo bar</title>
	</head>
	<body>
        <slot name="header"/>
		<slot name="content"/>
	</body>

    <style>
	html,
	body {
		margin: 0;
		height: 100%;
	}
    html { width: 100%; }
    body {
        width: 80%;
        max-width: 100%;
        margin: 0 auto 0 auto;
    }
</style>
</html>


